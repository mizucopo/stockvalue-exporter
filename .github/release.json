{
  "version": {
    "scheme": "semver",
    "sources": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "key": ["project", "version"]
      }
    ],
    "locks": [
      {
        "path": "uv.lock",
        "format": "toml-lock",
        "package": "stockvalue-exporter",
        "optional": true
      }
    ]
  },
  "publication": {
    "release_tag": "v{version}",
    "github_release": true,
    "release_paths": ["pyproject.toml", "Dockerfile"],
    "latest_image": "extended",
    "images": [
      {
        "name": "extended",
        "repository": "mizucopo/stockvalue-exporter",
        "tag": "{version}",
        "aliases": ["latest"],
        "registry": "dockerhub"
      }
    ]
  }
}
